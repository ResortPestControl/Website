{
  "buildCommand": "node tools/satellite.mjs; node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/pest-identification",
      "destination": "/pests/",
      "permanent": true
    },
    {
      "source": "/pest-identification/",
      "destination": "/pests/",
      "permanent": true
    },
    {
      "source": "/ants",
      "destination": "/pests/ants/",
      "permanent": true
    },
    {
      "source": "/ants/",
      "destination": "/pests/ants/",
      "permanent": true
    },
    {
      "source": "/cockroaches",
      "destination": "/pests/cockroaches/",
      "permanent": true
    },
    {
      "source": "/cockroaches/",
      "destination": "/pests/cockroaches/",
      "permanent": true
    },
    {
      "source": "/rodents",
      "destination": "/pests/rodents/",
      "permanent": true
    },
    {
      "source": "/rodents/",
      "destination": "/pests/rodents/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    },
    {
      "source": "/login/",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    },
    {
      "source": "/portal",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    },
    {
      "source": "/portal/",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    },
    {
      "source": "/pay",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    },
    {
      "source": "/pay/",
      "destination": "https://fieldbook.resortpestcontrol.com/portal",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
